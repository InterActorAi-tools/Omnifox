# Copy to `.env` on the target server and fill in real values.
# Never commit a real `.env` to git.

# ---- Images (set per environment) ----
# Prod uses :latest, staging uses :staging.
BACKEND_IMAGE=registry.gitlab.com/<group>/<project>/backend:latest
FRONTEND_IMAGE=registry.gitlab.com/<group>/<project>/frontend:latest

# ---- Runtime mode ----
ENVIRONMENT=production
DEBUG=False

# Allowed CORS origins for the backend (comma-separated, no spaces).
# Prod example:    CORS_ORIGINS=https://omnicat.in2-comms.com
# Staging example: CORS_ORIGINS=https://staging-omnicat.in2-comms.com
CORS_ORIGINS=https://omnicat.in2-comms.com

# ---- Postgres ----
POSTGRES_VERSION=18.1
POSTGRES_USER=omnicat
POSTGRES_PASSWORD=change-me
POSTGRES_DB=omnicat
DB_VOLUME_PATH=/data/omni-api/pg

# Connection string used by the backend - must match POSTGRES_* above
# and resolve to the `db` service inside the compose network.
DATABASE_URL=postgresql+psycopg2://omnicat:change-me@db:5432/omnicat

# ---- Backend secrets ----
# JWT signing key. App refuses to start if unset. Generate a high-entropy
# value:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# Encrypts personal data at rest. Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back it up: without it, stored data cannot be read.
DATA_ENCRYPTION_KEY=

# Google Gemini API key (used by the AI extraction pipeline).
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ExportComments API key (used to fetch social-media comment exports).
# Get one at https://exportcomments.com (Account -> API)
EXPORTCOMMENTS_API_KEY=

# Resend API key (transactional email).
RESEND_API_KEY=

# Google OAuth (sign-in with Google).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public https URL of the frontend. Used to build user-visible links
# (invite emails, password-reset emails). The backend hard-fails at
# startup if this is unset, or if it is not https in production.
# Prod example:    FRONTEND_URL=https://omnicat.in2-comms.com
# Staging example: FRONTEND_URL=https://staging-omnicat.in2-comms.com
FRONTEND_URL=https://omnicat.in2-comms.com

# ---- First-boot admin seed (one-time use) ----
# When the users table is empty AND both values below are set, the backend
# will create a single admin account on startup. After it succeeds, REMOVE
# these two values from this file and redeploy so the password no longer
# sits in your env.
#
# Password rules: >= 12 chars, must include letters AND non-letters, must
# not be in the common-defaults blocklist (e.g. "change-me", "admin123").
# If you skip this and seed manually instead, run:
#     docker compose exec backend python -m cli create-admin
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_NAME=Super Admin

# ---- Backend tuning ----
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# ---- Frontend runtime config ----
# Public URL the browser will call. The host reverse proxy
# should terminate TLS and forward /api to the backend.
PUBLIC_API_URL=https://omnicat.in2-comms.com/api

# ---- Bind-mounted paths on the host ----
BACKEND_UPLOADS_PATH=/data/omni-api/uploads
BACKEND_CACHE_PATH=/data/omni-api/cache

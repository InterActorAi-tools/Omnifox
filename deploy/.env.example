# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Web address without https://, e.g. omnifox.example.com or 203-0-113-10.sslip.io
SITE_ADDRESS=
POSTGRES_PASSWORD=
JWT_SECRET_KEY=
DATA_ENCRYPTION_KEY=
GEMINI_API_KEY=
EXPORTCOMMENTS_API_KEY=
# ExportComments jobs OmniFox may run at once (the key is shared with OmniCat, 5 in total).
EXPORTCOMMENTS_MAX_CONCURRENT=2
# Email through Resend (optional, see README). Leave empty to use copyable links only.
RESEND_API_KEY=
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=

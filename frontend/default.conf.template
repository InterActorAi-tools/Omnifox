server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # H7: Content Security Policy and supporting response headers.
    # The CSP_HEADER value is composed by docker-entrypoint.sh from the
    # deployed API URL ($API_URL); see that script for the policy text
    # and the rationale for each directive. Nginx's standard envsubst
    # step on *.template files (run on container boot) inlines the
    # value here. We pass it through a single placeholder so envsubst
    # only touches this one variable and not nginx's own $-references.
    add_header Content-Security-Policy "${CSP_HEADER}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location = /config.js {
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;
        add_header Content-Security-Policy "${CSP_HEADER}" always;
        expires off;
        try_files $uri =404;
    }

    location /assets/ {
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header Content-Security-Policy "${CSP_HEADER}" always;
        try_files $uri =404;
    }

    location / {
        # index.html must be rechecked so a new deploy's asset names are picked
        # up. "expires" sets Cache-Control without dropping the server-level
        # add_header security headers (a location-level add_header would).
        expires -1;
        try_files $uri $uri/ /index.html;
    }

    error_page 500 502 503 504 /index.html;
}
